EXPO_PUBLIC_PRIMARY_API_URL= 'https://api.met.no/weatherapi/locationforecast/2.0'
EXPO_PUBLIC_FALLBACK_API_URL= 'https://api.met.no/weatherapi/locationforecast/2.0'
EXPO_PUBLIC_PRIMARY_ALERTS_URL= 'https://www.ethiomet.gov.et/api/cap/rss.xml'
EXPO_PUBLIC_FALLBACK_ALERTS_URL= 'https://severeweather.wmo.int/v2/cap-alerts/et-emi-en/rss.xml'
EXPO_PUBLIC_APP_USER_AGENT= 'Climweb - Weather App v1'
EXPO_PUBLIC_APP_ALERTS_SENDER_ID= 'emi@ethiomet.gov.et'
EXPO_PUBLIC_APP_TIMEZONE = 'Africa/Addis_Ababa'
EXPO_PUBLIC_FORECAST_PROVIDER = 'yr'
EXPO_PUBLIC_ALERTS_PROVIDER = 'cap'
EXPO_PUBLIC_APP_COUNTRY_BBOX = '33.0,3.4,47.98,14.89'
# XYZ raster tile URL for the alert detail mini-map. The default below is
# OpenStreetMap's public tile server (fine for development only — see
# https://operations.osmfoundation.org/policies/tiles/). Point this at your
# own deployment's OSM tile server for production.
EXPO_PUBLIC_OSM_TILE_URL = 'https://tile.openstreetmap.org/{z}/{x}/{y}.png'
# In-app review prompt (all optional; defaults shown). For local testing set
# the thresholds to 0 and EXPO_PUBLIC_REVIEW_DEBUG=true (development builds
# only) — see docs/CONFIGURATION.md, In-app Review Prompt.
EXPO_PUBLIC_REVIEW_MIN_DAYS_USED = '5'
EXPO_PUBLIC_REVIEW_MIN_DAYS_SINCE_INSTALL = '7'
EXPO_PUBLIC_REVIEW_MIN_DAYS_BETWEEN_PROMPTS = '90'
EXPO_PUBLIC_REVIEW_MAX_PROMPTS = '3'
EXPO_PUBLIC_REVIEW_DEBUG = 'false'

# Default display units for a fresh install; users can change them in
# Settings > Units. Optional — unset or invalid values fall back to these.
#   temperature: celsius | fahrenheit
#   wind:        kmh | ms | knots | mph
#   rain:        mm | in
EXPO_PUBLIC_DEFAULT_TEMPERATURE_UNIT = 'celsius'
EXPO_PUBLIC_DEFAULT_WIND_UNIT = 'kmh'
EXPO_PUBLIC_DEFAULT_PRECIPITATION_UNIT = 'mm'
