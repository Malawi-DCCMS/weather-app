{
  "expo": {
    "name": "Climweb Weather App",
    "slug": "climweb_weather_app",
    "version": "1.7.1",
    "orientation": "portrait",
    "icon": "./assets/ic_launcher.png",
    "userInterfaceStyle": "automatic",
    "scheme": "climweb.weatherapp",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.climweb.weatherapp",
      "buildNumber": "1.7.1",
      "infoPlist": {},
      "appStoreUrl": "https://apps.apple.com/app/id1234567890"
    },
    "android": {
      "package": "com.climweb.weatherapp",
      "versionCode": 15,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.climweb.weatherapp"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "compileSdkVersion": 37,
            "targetSdkVersion": 37,
            "buildToolsVersion": "37.0.0",
            "gradleProperties": {
              "org.gradle.jvmargs": "-Xmx4096m -XX:MaxPermSize=2048m"
            }
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location.",
          "locationAlwaysPermission": "Allow $(PRODUCT_NAME) to use your location.",
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/ic_launcher.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-web-browser",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      "expo-sharing",
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "bef4595e-6aaa-4349-b669-c06646b868a0"
      }
    },
    "owner": "robeleq"
  }
}
